# private keeps the current self-hosted owner/user administration model.
# public isolates every customer and disables cross-account administration.
GESTORE_DEPLOYMENT_MODE=private
GESTORE_DATA_DIR=/data

# Required before a public App Store release.
GESTORE_PUBLIC_URL=https://example.invalid
GESTORE_SUPPORT_URL=https://github.com/IlSamm/umbrel-store/issues
GESTORE_PRIVACY_URL=https://example.invalid/legal/privacy.html

# Exact origins only. Required by the native iOS client in public mode.
GESTORE_ALLOWED_ORIGINS=capacitor://localhost
