# Runtime data and secrets must never enter source control.
data/*
!data/.gitkeep
**/*.sqlite
**/*.sqlite3
**/*.sqlite3-shm
**/*.sqlite3-wal
**/*.db
**/*.db-shm
**/*.db-wal

.env
.env.*
!.env.example

# Generated application and QA artifacts.
output/
dist/
node_modules/
www/
ios/App/App/public/
ios/DerivedData/
*.xcarchive
tmp/*-qa/
tmp/gestore-*/
tmp/**/gestore_data.sqlite3*
